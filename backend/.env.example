APP_NAME="Himalayan Momo House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail's MySQL service. Inside Docker the host is "mysql"; from your machine
# connect to 127.0.0.1:${FORWARD_DB_PORT}.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ordering
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Disk for uploaded logos and menu photos ("public" locally, "s3" in production).
MEDIA_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@example-restaurant.com.au"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Sail. WWWUSER/WWWGROUP let plain `docker compose` work on Windows,
# where the sail script can't read them from `id`.
WWWUSER=1000
WWWGROUP=1000
APP_PORT=80
FORWARD_DB_PORT=3307
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Windows with the project on a Windows drive (D:\...) rather than inside WSL:
# Docker shows every file there as owned by root, so run Sail's processes and
# commands as root too, or PHP can't write to storage/ and vendor/.
# APP_USER=root
# SUPERVISOR_PHP_USER=root

# Web app origins allowed to call the API (comma-separated). Production: https://example-restaurant.com.au
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Laravel Reverb (live order updates). `php artisan reverb:install` or
# `php artisan install:broadcasting --reverb` fills in the app ID, key and secret.
# REVERB_HOST is where Laravel publishes events: `reverb` (the Sail service) locally,
# the WebSocket host in production. Apps connect to their own EXPO_PUBLIC_REVERB_* values.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Stripe, test mode, for the demo restaurant only (https://dashboard.stripe.com/test/apikeys):
# DemoRestaurantSeeder gives it these. Every other restaurant's owner enters its own keys in
# the back office. The webhook secret comes from `stripe listen` (see docs/SETUP.md).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Optional: an Expo access token, if push security is enabled for the Expo projects. It's the
# same for every restaurant, so keep their EAS projects in one Expo account.
EXPO_ACCESS_TOKEN=

# The ordering website of a restaurant without a domain of its own: links in emails and table
# QR codes. A restaurant's own domain (its settings) is used instead when it has one.
ORDERING_WEB_URL=http://localhost:8081
