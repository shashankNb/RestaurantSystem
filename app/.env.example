# Copy to .env (it is git-ignored) and adjust. Restart `npx expo start` after changes.
#
# EXPO_PUBLIC_* values are compiled into the app and readable by anyone who has it.
# Never put a secret in them: no Stripe secret key, no Reverb app secret.

# The Laravel API, including /api/v1.
#   Web and iOS simulator:      http://localhost/api/v1
#   Android emulator:           http://10.0.2.2/api/v1
#   Physical phone on your LAN: http://<your computer's LAN IP>/api/v1
EXPO_PUBLIC_API_URL=http://localhost/api/v1

# The restaurant this build serves (its slug in the back office).
EXPO_PUBLIC_RESTAURANT_SLUG=himalayan-momo-house

# The public website, used for canonical links and Open Graph tags (phase 7).
EXPO_PUBLIC_WEB_URL=http://localhost:8081

# Laravel Reverb for live order updates. The key is REVERB_APP_KEY from backend/.env.
# Left empty, order screens poll every 10 seconds instead.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# Stripe publishable key, pk_test_… (Stripe Dashboard → Developers → API keys). Left
# empty, the checkout says payments aren't set up.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Build-time app identity, read by app.config.ts. Defaults are the demo restaurant's.
# APP_NAME=Himalayan Momo House
# APP_SLUG=himalayan-momo-house
# APP_SCHEME=himalayanmomohouse
# APP_BUNDLE_ID=au.com.examplerestaurant.ordering
# EAS_PROJECT_ID=                    needed for push notifications (`eas init` prints it)
# APP_APPLE_MERCHANT_ID=merchant.au.com.examplerestaurant.ordering   for Apple Pay
# GOOGLE_SERVICES_JSON=./google-services.json      Firebase config, for Android push
