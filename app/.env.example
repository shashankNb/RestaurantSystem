# Copy to .env (it is git-ignored) and adjust. Restart `npx expo start --clear` after changes.
#
# Which restaurant the app is for, and its name, icons, colours and website, come from its
# brand folder, brands/<BRAND>/ (see docs/ADDING_A_RESTAURANT.md). These settings are where
# the app finds the API and Reverb, the same for every restaurant.
#
# EXPO_PUBLIC_* values are compiled into the app and readable by anyone who has it.
# Never put a secret in them: no Stripe secret key, no Reverb app secret.

# The brand to build. Left out, the demo restaurant (brands/himalayan-momo-house/).
# BRAND=himalayan-momo-house

# The Laravel API, including /api/v1.
#   Web and iOS simulator:      http://localhost/api/v1
#   Android emulator:           http://10.0.2.2/api/v1
#   Physical phone on your LAN: http://<your computer's LAN IP>/api/v1
EXPO_PUBLIC_API_URL=http://localhost/api/v1

# Laravel Reverb for live order updates. The key is REVERB_APP_KEY from backend/.env.
# Left empty, order screens poll every 10 seconds instead.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# No Stripe key here: each restaurant's publishable key comes from the API, once its owner
# has entered its keys in the back office.

# Firebase config for Android push, for the brand being built (git-ignored). On EAS, a file
# variable of the same name.
# GOOGLE_SERVICES_JSON=./google-services.json
